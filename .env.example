# Database
DATABASE_URL=postgres://tokobun:tokobun@localhost:5433/tokobun
TEST_DATABASE_URL=postgres://tokobun:tokobun@localhost:5433/tokobun_test

# Telegram bot (from BotFather)
BOT_TOKEN=
BOT_USERNAME=
# Comma-separated Telegram user ids with admin rights in the bot
ADMIN_IDS=
# Forum supergroup (topics enabled) where support threads + order notifications go
ADMIN_CHAT_ID=
# Public channel link shown in main menu
CHANNEL_URL=

# API server (payment webhooks + reseller API)
API_PORT=3100
PUBLIC_API_URL=http://localhost:3100

# Payments
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_SANDBOX=true
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=true

# Bot webhook mode (optional; defaults to long polling)
# WEBHOOK_URL=https://example.com
# WEBHOOK_PATH=/telegram
# WEBHOOK_SECRET=
# BOT_PORT=8081
# Set to false to disable the broadcast worker in the bot process
# BROADCAST_WORKER=true

# Admin panel
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=change-me

# ---- PAYMENTS workstream (packages/payments + apps/api) — appended ----
# Tripay customer_email (required by Tripay); {userId} is replaced. Default tg{userId}@example.com
TRIPAY_CUSTOMER_EMAIL=
# CryptoBot accepted assets for USD invoices (comma-separated) and an optional fee added to the customer's total (basis points, 300 = 3%)
CRYPTOBOT_ASSETS=USDT,TON,BTC
CRYPTOBOT_FEE_BP=0
# DEV ONLY: offer the "manual" provider (admin marks payments paid). /webhooks/manual requires header x-manual-secret
PAYMENTS_DEV_MANUAL=false
PAYMENTS_DEV_MANUAL_SECRET=
# Reseller API rate limit per key (requests per minute)
API_RATE_LIMIT_PER_MIN=60
# Language of admin-chat notifications (id|en)
ADMIN_LANG=en
# ---- end PAYMENTS ----
